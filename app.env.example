# 复制到 local/app.env，不提交真实密钥或本机凭证。
MODEL_ENABLED=0
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
# 指向已授权本机.env里的DEEPSEEK_API_KEY；不要把密钥粘进聊天。
MODEL_KEY_FILE=
# 飞书只读取已有测试应用配置和已确认私聊白名单。
FEISHU_SECRETS_FILE=
FEISHU_ALLOWED_FILE=
# 本机独立协议服务：启动助手会启动/复用127.0.0.1:18081。
# 专用凭据由setup_local_app生成，不将真实token写入此模板。
MCP_ENABLED=1
# setup_memory.py 在本机建立偏好专用表/连接后启用，不复用订单只读账号写库。
MEMORY_ENABLED=0

# 合成商品快照聊天演示（非实时Shopify商品），按需启用；默认不开放。
CATALOG_DEMO_ENABLED=0
# 可选商品政策关联演示：demo.py up已导入合成T恤政策；自管库见docs/optional-services.md。
CATALOG_POLICY_DEMO_ENABLED=0
